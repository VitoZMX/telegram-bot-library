    "dotenv": "^16.4.5",
    "elevenlabs": "^1.50.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "play-dl": "^1.9.7",
    "playwright": "^1.48.2",
    "ruhend-scraper": "^8.0.8",
